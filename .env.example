APP_PORT=10001
APP_ENV=local
# Secret HMAC-SHA256 bersama antara Laravel (BACKEND_SECRET) dan Core
APP_KEY=dev-shared-secret-change-me
# JWT untuk otorisasi user login (kosong = fallback ke APP_KEY)
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL_SECOND=86400

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tumesan_db
DB_USER=postgres
DB_PASS=1234
SSL_MODE=disable

# OTP
OTP_TTL_SECOND=300
OTP_COOLDOWN_SECOND=60
OTP_MAX_ATTEMPT=3
# log = cetak OTP ke log server (dev) | fonnte
WA_PROVIDER=log
WA_TOKEN=
# grand_total di atas nilai ini wajib OTP saat bayar via SALDO_POIN (0 = selalu)
POINT_OTP_THRESHOLD=0

CASHBACK_PERCENT=0
MAX_MERCHANT_MARKUP=500000

# mock | digiflazz
PROVIDER_MODE=mock
PROVIDER_BASE_URL=https://api.digiflazz.com/v1
PROVIDER_USERNAME=
PROVIDER_API_KEY=
PROVIDER_CALLBACK_TOKEN=dev-provider-token
PG_CALLBACK_TOKEN=dev-pg-token
POLL_INTERVAL_SECOND=30
